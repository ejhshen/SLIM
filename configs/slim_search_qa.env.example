# Copy this file outside the repository and fill local values.
# Do not commit private paths or credentials.

export PROJECT_ROOT=/workspace/slim
# Optional: only set this when using an external base-agent repository.
export BASE_REPO_ROOT=

export MODEL_PATH=/models/base_model
export EMBEDDING_MODEL_PATH=/models/embedding_model
export SEARCH_QA_DATA_DIR=/datasets/search_qa_processed
export SEARCH_QA_RETRIEVER_DIR=/datasets/search_qa_retriever
export INITIAL_SKILLS=/workspace/slim/data/initial_skills/search_qa/skills.json

export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export N_GPUS_PER_NODE=8
export SEARCH_TRAIN_BATCH_SIZE=64
export SEARCH_VAL_BATCH_SIZE=512
export SEARCH_ROLLOUT_N=4
export OUTPUT_DIR=/workspace/slim/outputs/search_qa_slim_full
export LOG_DIR=/workspace/slim/logs

# Required only if lifecycle expansion is triggered.
export SKILL_CREATOR_BASE_URL=https://your-compatible-chat-endpoint/v1
export SKILL_CREATOR_API_KEY=your_api_key
export SKILL_CREATOR_MODEL=your_skill_creator_model

export EXTRA_ARGS=
